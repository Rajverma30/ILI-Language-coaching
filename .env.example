# ==============================================================================
# ILI FOREIGN LANGUAGES INSTITUTE — ALL-IN-ONE ENVIRONMENT TEMPLATE
# Apollo Tower, MG Road, New Palasia, Indore (M.P.), India
#
# Copy this file to .env or .env.local for local development.
# For Production deployments:
# Server Network & Runtime
PORT=5000
NODE_ENV=production

# Allowed CORS Origins (Comma-separated URLs of your deployed frontends on Vercel)
CORS_ORIGIN=https://your-customer-frontend.vercel.app,https://your-admin-frontend.vercel.app

# JWT Authentication Secrets
JWT_SECRET=your_32_character_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ili_languages_indore?retryWrites=true&w=majority
MONGODB_DB_NAME=ili_languages_indore

# Bunny Stream Video CDN (Server-side Video Management & Token Signing)
BUNNY_STREAM_LIBRARY_ID=your_bunny_library_id
BUNNY_STREAM_API_KEY=your_bunny_api_key
BUNNY_STREAM_TOKEN_AUTH_KEY=your_bunny_token_auth_key
BUNNY_STREAM_PULL_ZONE=your_bunny_pull_zone

# Razorpay Payment Gateway (Orders Creation & Webhook/Signature Verification)
RAZORPAY_KEY_ID=your_razorpay_key_id_rzp_live_or_test
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# UltraMsg WhatsApp Instant Lead Automation
ULTRAMSG_INSTANCE_ID=your_ultramsg_instance_id
ULTRAMSG_TOKEN=your_ultramsg_token
ADMIN_WHATSAPP_PHONE=+919826012345
ULTRAMSG_ENABLED=true

# WhatsApp Business Cloud API (Optional Meta Graph API fallback)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN=
WHATSAPP_DEMO_TEMPLATE_NAME=ili_demo_confirmation_indore


# ==============================================================================
# SECTION 2: VERCEL (CUSTOMER FRONTEND PROJECT)
# ==============================================================================

# Railway Backend API URL (Must end with /api)
NEXT_PUBLIC_API_URL=https://your-backend-name.up.railway.app/api
NEXT_PUBLIC_BACKEND_URL=https://your-backend-name.up.railway.app/api

# Bunny Stream Video Library ID (Required for student video player)
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=your_bunny_library_id

# Razorpay Public Key ID (Required for student checkout modal in browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_rzp_live_or_test

# Institute Contact & Brand Defaults
NEXT_PUBLIC_INSTITUTE_PHONE=+919826012345
NEXT_PUBLIC_INSTITUTE_EMAIL=admissions@ililanguages.in
NEXT_PUBLIC_INSTITUTE_LOCATION="Apollo Tower, New Palasia, Indore"


# ==============================================================================
# SECTION 3: VERCEL (ADMIN FRONTEND PROJECT)
# ==============================================================================

# Railway Backend API URL
NEXT_PUBLIC_API_URL=https://your-backend-name.up.railway.app/api

# Customer Portal URL for Preview Links
NEXT_PUBLIC_CUSTOMER_URL=https://your-customer-frontend.vercel.app

# Bunny Stream Admin Console Configuration
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=your_bunny_library_id
BUNNY_STREAM_LIBRARY_ID=your_bunny_library_id
BUNNY_STREAM_API_KEY=your_bunny_api_key
BUNNY_STREAM_PULL_ZONE=your_bunny_pull_zone
BUNNY_STREAM_TOKEN_AUTH_KEY=your_bunny_token_auth_key

# UltraMsg (Admin Settings Test Trigger)
ULTRAMSG_INSTANCE_ID=your_ultramsg_instance_id
ULTRAMSG_TOKEN=your_ultramsg_token
ADMIN_WHATSAPP_PHONE=+919826012345
