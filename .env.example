# ==============================================================================
# ILI Foreign Languages Institute - Environment Configuration Template
# Apollo Tower, MG Road, New Palasia, Indore, India
# NOTE: All secrets must remain in .env.local and NEVER committed to Git.
# In demo mode, the application runs entirely in client-side state without these.
# ==============================================================================

# 1. MongoDB Atlas Configuration
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ili_languages_indore?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/ili_languages_indore?retryWrites=true&w=majority"
MONGODB_DB_NAME=ili_languages_indore

# 2. NextAuth / JWT Authentication Secrets (Production)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_32_character_random_secret_key_here

# 3. Bunny Stream Configuration (Video CDN & Playback)
# Used for protected recorded lecture streaming with token authentication
BUNNY_STREAM_LIBRARY_ID=your_bunny_stream_library_id
BUNNY_STREAM_API_KEY=your_bunny_stream_api_key
BUNNY_STREAM_PULL_ZONE=your_bunny_pull_zone
BUNNY_STREAM_TOKEN_AUTH_KEY=your_bunny_token_auth_key

# 4. Razorpay Payment Gateway (India Domestic Checkout)
# Available from Razorpay Dashboard (API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# 5. WhatsApp Business Cloud API (Meta Developers)
# For automated admission alerts and demo booking notifications
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN=
WHATSAPP_DEMO_TEMPLATE_NAME=ili_demo_confirmation_indore

# 6. Institute Contact Information (Override Defaults)
NEXT_PUBLIC_INSTITUTE_PHONE=+919826012345
NEXT_PUBLIC_INSTITUTE_EMAIL=admissions@ililanguages.in
NEXT_PUBLIC_INSTITUTE_LOCATION="Apollo Tower, New Palasia, Indore"
