# ILI Foreign Languages Institute - Backend API Configuration
# Apollo Tower, MG Road, New Palasia, Indore, India

PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated for Customer and Admin Frontends)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# JWT Authentication Secrets
JWT_SECRET=ili_jwt_secure_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Optional MongoDB Atlas Connection
# If left empty, backend gracefully operates with high-fidelity in-memory seed store
MONGODB_URI=
MONGODB_DB_NAME=ili_languages_indore

# Bunny Stream Configuration (Video CDN & Server Token Signing)
# Official embed format: https://player.mediadelivery.net/embed/{libraryId}/{videoId}
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_STREAM_PULL_ZONE=

# Razorpay Payment Gateway (Server Order Verification)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp Business Cloud API (Automated Admission & Demo Confirmations)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_SYSTEM_USER_ACCESS_TOKEN=
WHATSAPP_DEMO_TEMPLATE_NAME=ili_demo_confirmation_indore

# UltraMsg WhatsApp Instant Lead Automation
# 1-second instant confirmation message to lead + instant alert to admin phone
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
ADMIN_WHATSAPP_PHONE=+919826012345
ULTRAMSG_ENABLED=false

